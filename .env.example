# Copy to .env and fill in:  cp .env.example .env

# Which environment to target: qa | stg | prod | dev | api
# Ignored when BASE_URL is set, so leave BASE_URL empty to switch with TTA_ENV.
TTA_ENV=qa
BASE_URL=

QA_BASE_URL=https://app.thetestingacademy.com
STG_BASE_URL=https://stage.thetestingacademy.com
PROD_BASE_URL=https://app.thetestingacademy.com
DEV_BASE_URL=http://localhost:3000
API_BASE_URL=https://restful-booker.herokuapp.com

LOG_LEVEL=info

# Shown in the header of the TTA custom report
TEST_ENV=QA
TEST_AUTHOR=your_name

# TTACart login (src/config/credentials.ts). Leave blank for the demo login:
# standard_user / tta_secret
STANDARD_USER=
TTA_SECRET=

# Restful Booker /auth login (src/tests/apiTests). Public demo credentials.
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123

# true attaches a screenshot to every visualStep() in the TTA report
ATTACH_SCREENSHOTS=false

# Optional: a fixed checkout customer for DataGenerator.checkoutCustomerFromEnv().
# Any field left unset is generated with Faker.
# CHECKOUT_FIRST_NAME=
# CHECKOUT_LAST_NAME=
# CHECKOUT_POSTAL_CODE=

# Optional: enables the AI Verdict tab in the TTA report (any one key)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ---- LLM Gateway (src/ai/LLMGateway.ts) ----
# Pick the provider your company allows: groq | openrouter | openai | anthropic | deepseek
# Leave empty to auto-pick the first provider that has a key (groq, openrouter, deepseek, openai, anthropic).
LLM_PROVIDER=
# Company allowlist. The gateway refuses any provider not listed here. Empty = all allowed.
# LLM_ALLOWED_PROVIDERS=groq,openrouter
# LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=2

# Keys (only the ones you use). Models are optional overrides of the built-in defaults.
# GROQ_API_KEY=            # free: https://console.groq.com/keys
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=      # free ":free" models: https://openrouter.ai/keys
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
# DEEPSEEK_API_KEY=        # https://platform.deepseek.com/api_keys
# DEEPSEEK_MODEL=deepseek-chat

# Optional: MySQL for data-driven tests (src/utils/dbReader.ts)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=playwright_ddt
